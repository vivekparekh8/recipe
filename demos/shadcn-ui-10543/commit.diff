diff --git a/apps/v4/registry/select.test.ts b/apps/v4/registry/select.test.ts
new file mode 100644
index 00000000..80b62d1a
--- /dev/null
+++ b/apps/v4/registry/select.test.ts
@@ -0,0 +1,42 @@
+import fs from "node:fs"
+import path from "node:path"
+import { describe, expect, it } from "vitest"
+
+const registryRoot = path.resolve(import.meta.dirname)
+const alignmentInset =
+  "data-[side=none]:min-w-[calc(var(--anchor-width)+--spacing(7))]"
+
+describe("Base Select popup sizing", () => {
+  it("adds item-alignment inset only while alignItemWithTrigger is active", () => {
+    const select = fs.readFileSync(
+      path.join(registryRoot, "bases/base/ui/select.tsx"),
+      "utf8"
+    )
+
+    expect(select).toContain("w-(--anchor-width)")
+    expect(select).toContain(alignmentInset)
+    expect(select).not.toContain("data-[align-trigger=true]:min-w-")
+  })
+
+  it("keeps every generated Base style in sync without changing Radix", () => {
+    const stylesRoot = path.resolve(registryRoot, "../styles")
+    const baseStyles = fs
+      .readdirSync(stylesRoot)
+      .filter((style) => style.startsWith("base-"))
+
+    expect(baseStyles).toHaveLength(8)
+    for (const style of baseStyles) {
+      const select = fs.readFileSync(
+        path.join(stylesRoot, style, "ui/select.tsx"),
+        "utf8"
+      )
+      expect(select, style).toContain(alignmentInset)
+    }
+
+    const radixSelect = fs.readFileSync(
+      path.join(stylesRoot, "radix-luma/ui/select.tsx"),
+      "utf8"
+    )
+    expect(radixSelect).not.toContain(alignmentInset)
+  })
+})
